{
  "name": "accsys",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:prod-local": "ALLOW_HTTP_LOCALHOST=true next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait && npm run test:db:prepare",
    "test:db:prepare": "MIGRATION_DATABASE_URL=postgres://accsys_migrator:accsys_migrator_test@127.0.0.1:25432/accsys_test tsx scripts/db-migrate.ts && docker compose -f docker-compose.test.yml exec -T db-test psql -U accsys_test -d accsys_test -v ON_ERROR_STOP=1 -q -f /fixtures/base.sql",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "seed": "tsx scripts/import-seed-data.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "seed:forms": "tsx scripts/seed-sample-forms.ts",
    "forms:migrate": "tsx scripts/migrate-forms.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "app:migrate": "docker compose -f docker-compose.yml -f docker-compose.app.yml run --rm --build migrate",
    "app:up": "docker compose -f docker-compose.yml -f docker-compose.app.yml up -d --build app",
    "app:down": "docker compose -f docker-compose.yml -f docker-compose.app.yml down",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:baseline": "tsx scripts/db-baseline.ts",
    "db:generate": "drizzle-kit generate",
    "auth:bootstrap": "tsx scripts/auth-bootstrap.ts",
    "attachments:rescan": "tsx scripts/attachments-rescan.ts",
    "directory:dry-run": "tsx scripts/directory-sync.ts",
    "directory:sync": "tsx scripts/directory-sync.ts --live --apply",
    "directory:authorize": "tsx scripts/directory-authorize.ts",
    "dev:all": "bash scripts/start-dev.sh",
    "dev:all:seed": "bash scripts/start-dev.sh --seed"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "iron-session": "^8.0.4",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "openid-client": "^6.8.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.0",
    "jose": "^6.2.12",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
