{
  "name": "accsys",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "seed": "tsx scripts/import-seed-data.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "app:up": "docker compose -f docker-compose.yml -f docker-compose.app.yml up -d --build",
    "app:down": "docker compose -f docker-compose.yml -f docker-compose.app.yml down",
    "db:schema:apply": "tsx scripts/apply-schema.ts",
    "dev:all": "bash scripts/start-dev.sh",
    "dev:all:seed": "bash scripts/start-dev.sh --seed"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "iron-session": "^8.0.4",
    "next": "^15.5.26",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.9",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
