# 執行期只用最小權限帳號 accsys_app（僅 DML）。本機 docker 的預設開發密碼見 docker-compose.yml。
DATABASE_URL=postgres://accsys_app:accsys_app_dev@127.0.0.1:15432/accsys
# migration 專用（accsys_migrator）；web 程式不讀這個變數。
MIGRATION_DATABASE_URL=postgres://accsys_migrator:accsys_migrator_dev@127.0.0.1:15432/accsys
SESSION_SECRET=replace-with-at-least-32-characters-long
STORAGE_LOCAL_PATH=./data/attachments
# 附件掃描：clamav（本機 clamd，檔案不送外部）或 disabled（僅開發）。正式環境未設定 clamav 會拒絕上傳。
ATTACHMENT_SCAN=disabled
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# 確認 HTTPS 與正式網域後才開啟 HSTS
# ENABLE_HSTS=true

# 登入。APP_ORIGIN 是瀏覽器使用的固定網址（callback = APP_ORIGIN/auth/callback），
# 不從 Host 標頭推斷；正式環境必須 https。
APP_ORIGIN=http://localhost:3001
# manual：Google 帳號須由管理員在 /admin/accounts 核准綁定。directory 模式待 P6 目錄同步。
AUTH_MODE=manual
# 允許的 Google Workspace 網域（逗號分隔），同時驗證 ID token 的 hd 與 email 網域。
ALLOWED_GOOGLE_DOMAINS=turing-drive.com
# session 絕對壽命（小時，上限 12）。
SESSION_TTL_HOURS=8
# 反向代理覆寫的用戶端 IP 標頭（例：x-real-ip），用於登入限速；未設定則所有來源共用一個計數。
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Google OAuth（公司 Google API 專案 → 憑證）。已授權的重新導向 URI 須完全等於 APP_ORIGIN/auth/callback。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 示範角色登入（預設關閉）。僅 `next dev` + 旗標 true + APP_ORIGIN 為 localhost 時可用；
# 正式／共用環境勿開。登入頁以 Google Workspace 為主。
DEV_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN=false

# 整合測試專用（拋棄式 DB，名稱必須以 _test 結尾；不要指向 DATABASE_URL）
# TEST_DATABASE_URL=postgres://accsys_app:accsys_app_test@127.0.0.1:25432/accsys_test
# TEST_ADMIN_DATABASE_URL=postgres://accsys_test:accsys_test@127.0.0.1:25432/accsys_test
