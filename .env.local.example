DATABASE_URL=postgres://accsys:accsys@localhost:15432/accsys
SESSION_SECRET=replace-with-at-least-32-characters-long
ALLOWED_GOOGLE_DOMAIN=turing-drive.com
STORAGE_LOCAL_PATH=./data/attachments

# Google OAuth（GCP Console → API 與服務 → 憑證）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 本機略過 Google 登入：只在 `next dev`（NODE_ENV=development）且下列旗標為 true 時生效；
# `next build`/`next start`/容器映像一律拒絕（/auth/dev 回 404）。共享環境不可開啟。
DEV_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN=false

# 整合測試專用（拋棄式 DB，名稱必須以 _test 結尾；不要指向 DATABASE_URL）
# TEST_DATABASE_URL=postgres://accsys_test:accsys_test@127.0.0.1:25432/accsys_test
