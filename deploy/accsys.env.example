# Non-secret settings for deploy/compose.prod.yml. Copy to /etc/accsys/accsys.env
# (root:root 0640) and pass with --env-file. Secrets never go in this file;
# they are files under ACCSYS_SECRETS_DIR (docs/operations/deployment.md).

# Images: registry digest, or accsys-app:<commit> after a verified docker load
# (docs/operations/deployment.md「映像」).
ACCSYS_APP_IMAGE=accsys-app@sha256:REPLACE
ACCSYS_MIGRATE_IMAGE=accsys-migrate@sha256:REPLACE
# clamav-debian is published for amd64 and arm64; clamav/clamav (Alpine) is amd64 only.
ACCSYS_CLAMAV_IMAGE=clamav/clamav-debian:REPLACE@sha256:REPLACE

# Public name and origin (must match the Google OAuth redirect URI).
ACCSYS_FQDN=accsys.example.com
APP_ORIGIN=https://accsys.example.com
ALLOWED_GOOGLE_DOMAINS=example.com
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com

# Directory sync job only (accsys-directory-sync.timer). Leave empty until the
# company approves the read-only sync account; the secrets
# gws_directory_client_secret / gws_directory_refresh_token live in ACCSYS_SECRETS_DIR.
GWS_CUSTOMER_ID=
GWS_DIRECTORY_CLIENT_ID=

# Listen address and ports on this host.
ACCSYS_BIND_ADDRESS=0.0.0.0
ACCSYS_HTTPS_PORT=443
ACCSYS_HTTP_PORT=80

# Host paths. Create them beforehand; nothing is created automatically.
ACCSYS_DATA_DIR=/srv/accsys
ACCSYS_BACKUP_DIR=/srv/accsys/backup
ACCSYS_SECRETS_DIR=/etc/accsys/secrets
ACCSYS_TLS_DIR=/etc/accsys/tls

# Runtime account (app, migrate, admin-cli, backup). Must not belong to any
# login user on this host: `getent passwd 10001` should print nothing, or the
# accsys system user created for it (docs/operations/deployment.md).
ACCSYS_UID=10001
ACCSYS_GID=10001

SESSION_TTL_HOURS=8
ENABLE_HSTS=true
BACKUP_KEEP_DAYS=14
